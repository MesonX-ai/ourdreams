# Copy to .env.local and fill in when WooCommerce keys arrive.
# These are BUILD-TIME secrets used by Tier-1 prerendering only.
# They are NEVER prefixed NEXT_PUBLIC_ and must never reach the browser.
#
# Until populated, the build uses schema-accurate fixtures in lib/wc/fixtures.

WP_BASE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Local PHP dev server (used by next.config.mjs rewrites in `next dev`).
PHP_BACKEND=http://127.0.0.1:8000
